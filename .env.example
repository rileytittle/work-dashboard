# Copy this to .env.local and fill in what you use. Every panel works on its own —
# skip anything you don't need and switch that panel off in Settings.

# Linear — Issues panel, and issues closed in the daily report.
# Settings → Security & access → Personal API keys
LINEAR_API_KEY=

# GitHub — Reviews panel, and pull requests in the daily report.
# Leave blank to reuse the github.com login git already has on this machine.
GITHUB_TOKEN=

# Spotify — player. Client ID only, no secret (the app uses PKCE).
# https://developer.spotify.com/dashboard, redirect URI http://127.0.0.1:3000/callback
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Meetings and Slack in the daily report need no keys here: Claude reads them
# through the Google Calendar and Slack connectors your Claude account already has.

# When the daily report runs, 24-hour local time. 4:40 PM by default.
REPORT_AT=16:40

# Optional — the wordmark in the top left and the browser tab title.
NEXT_PUBLIC_DASHBOARD_TITLE=Dashboard
